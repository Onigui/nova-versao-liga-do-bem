# Database
DATABASE_URL="postgresql://username:password@localhost:5432/liga_do_bem_db"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# Firebase / Push (FCM HTTP v1)
# Cole o JSON inteiro da conta de serviço (uma linha) OU os 3 campos abaixo.
# Não use mais FIREBASE_SERVER_KEY (API legado desligada pelo Google).
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com"}'
FIREBASE_PROJECT_ID="liga-do-bem-botucatu-4c696"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@liga-do-bem-botucatu-4c696.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin demo (NÃO use em produção). Se true, permite admin@ligadobem.com / admin123
ALLOW_DEMO_ADMIN="false"

# OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# Email (obrigatório para recuperação de senha — o código NUNCA é devolvido na API)
# Opção A: SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Liga do Bem <noreply@seudominio.com>"
# Opção B: Resend (alternativa ao SMTP)
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Liga do Bem <noreply@seudominio.com>"

# Cloudinary (para upload de imagens)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Payment — PagBank (Orders API)
# Cole o token no painel da Vercel (nunca no código)
PAGBANK_TOKEN="seu-token-pagbank"
# sandbox | production
PAGBANK_ENV="production"
# Parcelas sem juros assumidas pela associação (1 = só à vista sem juros)
PAGBANK_INTEREST_FREE_INSTALLMENTS="1"
# BIN usado só na listagem inicial, antes do usuário digitar o cartão (exemplo oficial Mastercard)
PAGBANK_DEFAULT_CARD_BIN="552100"
# URL pública da API (webhook)
API_PUBLIC_URL="https://nova-versao-liga-do-bem.vercel.app"

# Legado (opcional)
PAGSEGURO_EMAIL="your-pagseguro-email"
PAGSEGURO_TOKEN="your-pagseguro-token"
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-token"

# CORS
FRONTEND_URL="http://localhost:3000"
MOBILE_URL="exp://localhost:19000"
ADMIN_URL="http://localhost:3000"  # URL do admin (Vercel)
WEB_URL="http://localhost:3000"    # URL do site (Vercel)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
