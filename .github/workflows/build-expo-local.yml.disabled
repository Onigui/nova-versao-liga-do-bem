name: 🎯 Build APK com Expo (Local - Gratuito)

on:
  workflow_dispatch:
    inputs:
      build_type:
        description: 'Tipo de build'
        required: true
        default: 'apk'
        type: choice
        options:
          - apk
          - aab
  push:
    branches:
      - master
    paths:
      - 'mobile/**'
      - '.github/workflows/build-expo-local.yml'

jobs:
  build:
    name: 📱 Build Local com Expo
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4

      - name: 🏗 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18.x'
          cache: 'npm'
          cache-dependency-path: mobile/package-lock.json

      - name: ☕ Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: 🔧 Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: 📦 Install dependencies
        working-directory: ./mobile
        run: |
          echo "📦 Instalando dependências..."
          npm ci
          
          echo "📦 Instalando EAS CLI globalmente..."
          npm install -g eas-cli

      - name: 🔑 Setup Release Keystore
        working-directory: ./mobile
        run: |
          echo "🔑 Criando keystore para assinatura..."
          
          keytool -genkeypair \
            -v \
            -storetype PKCS12 \
            -keystore release.keystore \
            -alias ligadobem \
            -keyalg RSA \
            -keysize 2048 \
            -validity 10000 \
            -storepass android \
            -keypass android \
            -dname "CN=Liga do Bem, OU=Mobile, O=Liga do Bem Botucatu, L=Botucatu, ST=SP, C=BR"
          
          echo "✅ Keystore criado"

      - name: 🏗️ Build APK Localmente (100% Gratuito!)
        working-directory: ./mobile
        run: |
          echo "🏗️ Iniciando build LOCAL com Expo (sem usar servidores Expo)..."
          
          # Exportar variáveis
          export EXPO_NO_TELEMETRY=1
          export EXPO_NO_GIT_STATUS=1
          
          BUILD_TYPE="${{ github.event.inputs.build_type || 'apk' }}"
          
          # Build LOCAL (NÃO usa servidores Expo = GRATUITO!)
          eas build --platform android \
            --profile production \
            --local \
            --non-interactive \
            --clear-cache \
            --output ./build-output.apk
          
          echo "✅ Build concluído!"
          
          # Copiar APK para local acessível
          if [ -f "build-output.apk" ]; then
            cp build-output.apk ../liga-do-bem-botucatu-v1.2.2.apk
            echo "📦 APK copiado com sucesso!"
            ls -lh ../liga-do-bem-botucatu-v1.2.2.apk
          else
            echo "⚠️ APK não encontrado, procurando em outros locais..."
            find . -name "*.apk" -type f
          fi

      - name: 📦 Upload APK as artifact
        uses: actions/upload-artifact@v4
        with:
          name: liga-do-bem-apk-v1.2.2-build-${{ github.run_number }}
          path: |
            mobile/*.apk
            mobile/build-output.apk
            liga-do-bem-botucatu-v1.2.2.apk
          retention-days: 30
          if-no-files-found: warn

      - name: 🎉 Create GitHub Release
        if: github.event_name == 'push' || github.event.inputs.build_type == 'apk'
        uses: softprops/action-gh-release@v1
        with:
          tag_name: v1.2.2-local-build-${{ github.run_number }}
          name: Liga do Bem v1.2.2 Build Local ${{ github.run_number }}
          body: |
            ## 📱 Liga do Bem Botucatu - Build Local (100% Gratuito!)
            
            ### ✨ Build Info
            - **Versão**: 1.2.2
            - **Build**: ${{ github.run_number }}
            - **Tipo**: Expo Local Build (SEM custos!)
            - **Branch**: ${{ github.ref_name }}
            - **Commit**: ${{ github.sha }}
            
            ### 🎯 Vantagens Build Local:
            - ✅ **100% Gratuito** (não usa servidores Expo)
            - ✅ **Sem limites** de builds
            - ✅ **Compatível** com estrutura Expo existente
            - ✅ **Rápido** (~5-10 minutos)
            
            ### 📥 Download
            Baixe o APK abaixo e instale no seu dispositivo Android.
          files: liga-do-bem-botucatu-v1.2.2.apk
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: 📊 Build Summary
        if: always()
        run: |
          echo "## 🎯 Build Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- **Build Type**: Expo Local (Gratuito!)" >> $GITHUB_STEP_SUMMARY
          echo "- **Status**: ${{ job.status }}" >> $GITHUB_STEP_SUMMARY
          echo "- **Branch**: ${{ github.ref_name }}" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          
          if [ -f "liga-do-bem-botucatu-v1.2.2.apk" ]; then
            APK_SIZE=$(du -h liga-do-bem-botucatu-v1.2.2.apk | cut -f1)
            echo "- **APK Size**: $APK_SIZE" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "✅ **APK gerado com build LOCAL (sem custos)!**" >> $GITHUB_STEP_SUMMARY
          else
            echo "❌ **Build falhou**" >> $GITHUB_STEP_SUMMARY
          fi
