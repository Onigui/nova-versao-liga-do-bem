{
  "version": 2,
  "buildCommand": "cd backend && npm install && npx prisma generate",
  "builds": [
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    }
  ],
  "functions": {
    "backend/api/index.ts": {
      "maxDuration": 60
    }
  }
}

